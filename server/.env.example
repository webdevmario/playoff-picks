# Copy to server/.env to override defaults.

# Port the server listens on (tailscale serve proxies HTTPS :8447 to this)
# PORT=5174

# 127.0.0.1 keeps it reachable only through `tailscale serve` (recommended).
# HOST=127.0.0.1

# Where the database lives. Default: ~/Library/Application Support/playoff-picks
# Point dev runs somewhere else to avoid touching real data.
# DATA_DIR=~/Library/Application Support/playoff-picks
